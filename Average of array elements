#include <iostream>
using namespace std;

int main()
{
    int arr[5], sum = 0;
    float average;

    cout << "Enter 5 elements: ";

    // Read array elements
    for (int i = 0; i < 5; i++)
    {
        cin >> arr[i];
    }

    // Calculate sum
    for (int i = 0; i < 5; i++)
    {
        sum = sum + arr[i];
    }

    // Calculate average
    average = sum / 5.0;

    cout << "Average = " << average;

    return 0;
}
