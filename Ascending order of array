#include <iostream>
using namespace std;

int main()
{
    int arr[5], temp;

    cout << "Enter 5 elements: ";

    // Read array elements
    for (int i = 0; i < 5; i++)
    {
        cin >> arr[i];
    }

    // Sort the array in ascending order
    for (int i = 0; i < 5; i++)
    {
        for (int j = i + 1; j < 5; j++)
        {
            if (arr[i] > arr[j])
            {
                temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
    }

    cout << "Array in ascending order: ";

    // Display the sorted array
    for (int i = 0; i < 5; i++)
    {
        cout << arr[i] << " ";
    }

    return 0;
}
